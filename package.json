{
  "name": "wordquest",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "~56.0.8",
    "expo-av": "^16.0.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "vitest": "^3.2.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "tests/**/*.test.ts"
    ],
